{
  "manifest_version": 3,
  "name": "Property Listing Enhancer",
  "version": "1.0.0",
  "description": "Enhances property listings with postcodes and quick links to EPC certificates and flood risk information",
  "content_scripts": [
    {
      "matches": ["https://www.rightmove.co.uk/properties/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png",
    "128": "icons/apple-touch-icon.png",
    "192": "icons/android-chrome-192x192.png",
    "512": "icons/android-chrome-512x512.png"
  }
}
